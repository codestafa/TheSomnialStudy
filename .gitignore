# Unity .gitignore for The Somnial Study
# Optimized for GitHub and collaborative development
# Last updated: 2025-11-27

# ============================================================================
# Unity Generated Files
# ============================================================================

# Unity project folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size and may contain sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Asset Store Tools (uncomment if you use Asset Store)
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity crash reports
sysinfo.txt

# Unity3D generated meta files for non-asset files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ============================================================================
# Recovery & Backup Files (IMPORTANT - Prevents large files in repo)
# ============================================================================

# Unity auto-save and recovery folders
**/_Recovery/
**/GeneratedAssets_deleted/
/Assets/_Recovery/
/GeneratedAssets_deleted/

# Backup files
*.bak
*.backup
*~

# Archived/old versions
**/_Archive/
**/_Old/
**/_Backup/

# ============================================================================
# Build Outputs
# ============================================================================

*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86_64
*.x86

# ============================================================================
# IDE & Editor Files
# ============================================================================

# Visual Studio / Visual Studio Code
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.sln.iml

# Consulo
.consulo/
ExportedObj/

# Gradle (for Android builds)
.gradle/

# ============================================================================
# Operating System Files
# ============================================================================

# Windows
Thumbs.db
Thumbs.db.meta
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.DS_Store.meta
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.fuse_hidden*

# ============================================================================
# Project-Specific Files
# ============================================================================

# Custom: Third-party assets folder
/Assets/Assets/

# Custom: Animations folder (if not needed in repo)
/Assets/Animations

# FPS logging directory
/fpslog/

# Log files
*.log

# ============================================================================
# Unity Asset & Build Files
# ============================================================================

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Crashlytics
crashlytics-build.properties
fabric.properties

# ============================================================================
# Large Binary Files (Optional - uncomment if needed)
# ============================================================================

# Uncomment these if you want to exclude large media files
# Consider using Git LFS instead for large assets
# *.mp4
# *.mov
# *.wav
# *.mp3
# *.fbx
# *.obj
# *.blend
# *.psd
# *.ai

# ============================================================================
# Unity Package Manager
# ============================================================================

# Package cache
/[Pp]ackages/packages-lock.json

# ============================================================================
# Testing & Debug
# ============================================================================

# Test results
TestResults/
test-results/

# Coverage reports
coverage/
*.coverage
*.coveragerc

# ============================================================================
# Documentation Build Output (if using documentation generators)
# ============================================================================

# DocFX
_site/
api/
manifest.json
xrefmap.yml

